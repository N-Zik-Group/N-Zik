    <string name="recovery_confirm_kill_app">Wymuś zakończenie procesu aplikacji? Zabójstwo jest natychmiastowe i nie może zostać cofnięte, a operacja może zostać przerwana w toku.</string>
    <string name="recovery_confirm_reset_database">Zresetować bazę danych? Kopia zapasowa będzie przechowywana do przywrócenia.</string>
