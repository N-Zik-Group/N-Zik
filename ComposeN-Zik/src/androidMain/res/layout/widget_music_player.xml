<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:theme="@style/Theme.Widget.NZikWidget">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_background"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Album Art Section (Left) -->
            <LinearLayout
                android:id="@+id/widget_album_art_container"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            
            <ImageView
                android:id="@+id/widget_album_art"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/album_art" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Chronometer
                    android:id="@+id/widget_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary"
                    android:format="%s" />

                <TextView
                    android:id="@+id/widget_total_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Content Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <!-- Top Row: Song Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/widget_song_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_not_playing_status"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_artist_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_action_tap_to_play"
                    android:textSize="13sp"
                    android:textColor="@color/widget_text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Middle Row: Interactive Elements -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false" android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Like Button -->
                <FrameLayout
                    android:id="@+id/widget_like_container"
                    android:layout_width="32dp"
                    android:layout_height="32dp">

                    <ImageView
                        android:id="@+id/widget_like_button_bg_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_like_button_bg"
                        android:scaleType="fitXY" />

                    <ImageButton
                        android:id="@+id/widget_like_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_widget_heart_outline_nav"
                        android:contentDescription="@string/player_action_like" />
                </FrameLayout>
                
                <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <!-- Previous Button -->
                <FrameLayout
                    android:id="@+id/widget_prev_container"
                    android:layout_width="38dp"
                    android:layout_height="38dp">
                    <ImageView
                        android:id="@+id/widget_prev_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_widget_skip_previous"
                        android:contentDescription="@string/common_action_previous" />
                </FrameLayout>

                <!-- Play/Pause Container -->
                <FrameLayout
                    android:id="@+id/widget_play_pause_container"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <ImageView
                        android:id="@+id/widget_play_pause_bg_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_play_pill_bg"
                        android:scaleType="fitXY" />

                    <ImageView
                        android:id="@+id/widget_play_pause"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_widget_play"
                        android:contentDescription="@string/widget_action_play_pause" />
                </FrameLayout>
                
                <!-- Next Button -->
                <FrameLayout
                    android:id="@+id/widget_next_container"
                    android:layout_width="38dp"
                    android:layout_height="38dp">
                    <ImageView
                        android:id="@+id/widget_next_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_widget_skip_next"
                        android:contentDescription="@string/common_action_next" />
                </FrameLayout>

            </LinearLayout>

            <!-- Bottom Row: Progress Bar -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp">

                <ImageView
                    android:id="@+id/widget_progress_track"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_progress_track"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/widget_progress_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_progress_clip"
                    android:scaleType="fitXY" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>