<?xml version="1.0" encoding="utf-8"?>
<!-- Compact widget: metadata and controls above a full-width elapsed/duration row. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.NZikWidget">
    <ImageView
        android:id="@+id/widget_wide_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_background"
        android:scaleType="fitXY" />
<LinearLayout
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

    <!-- Album Art - Square -->
    <ImageView
        android:id="@+id/widget_wide_album_art"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_box"
        android:contentDescription="@string/album_art" />

    <!-- Song Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_wide_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_not_playing_status"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_wide_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_action_tap_to_play"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />


    </LinearLayout>

    <!-- Controls Container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="4dp">

        <FrameLayout
            android:id="@+id/widget_wide_like_container"
            android:layout_width="24dp"
            android:layout_height="24dp">
            <ImageView
                android:id="@+id/widget_wide_like_button_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_like_button_bg"
                android:scaleType="fitXY" />
            <ImageButton
                android:id="@+id/widget_wide_like_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_heart_outline_nav"
                android:contentDescription="@string/player_action_like" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_wide_prev_container"
            android:layout_width="24dp"
            android:layout_height="24dp">
            <ImageView
                android:id="@+id/widget_wide_prev_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_skip_previous"
                android:contentDescription="@string/common_action_previous" />
        </FrameLayout>

        <!-- Play Button -->
        <FrameLayout
            android:id="@+id/widget_wide_play_container"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <ImageView
                android:id="@+id/widget_wide_play_pause_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_play_button_circular"
                android:scaleType="fitXY" />
            <ImageView
                android:id="@+id/widget_wide_play_pause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_play_low"
                android:contentDescription="@string/widget_action_play_pause" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_wide_next_container"
            android:layout_width="24dp"
            android:layout_height="24dp">
            <ImageView
                android:id="@+id/widget_wide_next_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_skip_next"
                android:contentDescription="@string/common_action_next" />
        </FrameLayout>
    </LinearLayout>

    </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_wide_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Chronometer
                android:id="@+id/widget_wide_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/widget_text_secondary"
                android:format="%s" />
            <TextView
                android:id="@+id/widget_wide_total_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>
</LinearLayout>
</FrameLayout>
