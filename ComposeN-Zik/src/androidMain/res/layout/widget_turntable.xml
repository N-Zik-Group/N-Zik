<?xml version="1.0" encoding="utf-8"?>
<!-- Turntable Widget - Circular design with play and navigation buttons -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp"
    android:theme="@style/Theme.Widget.NZikWidget">

    <!-- Album Art - circular bitmap set programmatically -->
    <ImageView
        android:id="@+id/widget_turntable_album_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_turntable_default_art"
        android:contentDescription="@string/album_art" />

    <!-- Navigation Buttons Container - Top Right (Previous & Next) -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="6dp">

        <ImageView
            android:id="@+id/widget_turntable_nav_bg_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_turntable_nav_bg"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <!-- Previous Button -->
        <ImageButton
            android:id="@+id/widget_turntable_prev_button"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_widget_skip_previous"
            android:contentDescription="@string/common_action_previous" />

        <!-- Next Button -->
        <ImageButton
            android:id="@+id/widget_turntable_next_button"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_widget_skip_next"
            android:contentDescription="@string/common_action_next" />

        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <!-- Play Button - Bottom Left -->
        <FrameLayout
            android:id="@+id/widget_turntable_play_container"
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/widget_turntable_play_bg_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_turntable_play_bg"
                android:scaleType="fitXY" />
            <ImageView
                android:id="@+id/widget_turntable_play_pause"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_play_secondary"
                android:contentDescription="@string/widget_action_play_pause" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Time display - center bottom -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:gravity="center">

            <Chronometer
                android:id="@+id/widget_turntable_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#CCFFFFFF"
                android:format="%s" />

            <TextView
                android:id="@+id/widget_turntable_total_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#88FFFFFF"
                android:text="" />
        </LinearLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Like Button - Bottom Right -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/widget_turntable_like_bg_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_turntable_like_bg"
                android:scaleType="fitXY" />
            <ImageButton
                android:id="@+id/widget_turntable_like_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_heart_outline_nav"
                android:contentDescription="@string/player_action_like" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
